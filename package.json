{
    "name": "webrdp",
    "version": "2.0.0",
    "description": "Clientless RDP web gateway: open Windows desktops in a browser, with server-side login and a target allowlist. No plugin, no client install, no third-party cloud.",
    "license": "MIT",
    "type": "commonjs",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "node test-proxy.js"
    },
    "keywords": [
        "rdp",
        "remote-desktop",
        "browser",
        "webassembly",
        "ironrdp",
        "gateway",
        "clientless"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bboytzi/webrdp.git"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "express": "^4.22.3",
        "express-ws": "^5.0.2",
        "ironrdp-wasm": "^1.1.0"
    }
}
