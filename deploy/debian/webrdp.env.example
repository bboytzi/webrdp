# /etc/webrdp.env
# systemd 的环境变量文件（webrdp.service 里用 EnvironmentFile 加载）。
# 这个文件含登录口令 —— 权限保持 600、属主 root，且绝不要放进 web 目录。
#
# 语法：KEY=value，每行一个；值里如果有空格或特殊字符，用双引号包起来。

PORT=8080
HOST=0.0.0.0

# ---- 登录认证（公网发布必须设置） ----
AUTH_USER=admin
AUTH_PASS=change-this-to-a-long-random-password

# 走 HTTPS 时打开：让会话 cookie 带上 Secure 标记
# COOKIE_SECURE=1

# ---- 被控机清单（多台） ----
# 格式：标签=主机:端口，逗号分隔。
#   * 标签是前端下拉框里显示的文字（建议不要写敏感信息）
#   * 未写端口时默认 3389
#   * 【这份清单同时就是拨号白名单】，网关只会连这里列出的地址；
#     前端下拉框也只列这些，不会出现"填了却连不上"
RDP_TARGETS="办公机=192.168.1.100:3389,测试机=192.168.1.101:3389"

# ---- 单机模式（不使用 RDP_TARGETS 时） ----
# 不配 RDP_TARGETS 时，前端退回"手动输入主机地址"，此时用下面这条做白名单：
# RDP_ALLOWED_DESTS=192.168.1.100:3389
