# webrdp configuration
#
# Copy this file to .env and edit it:
#     Windows :  copy .env.example .env        (then edit with Notepad)
#     Linux   :  cp .env.example .env && chmod 600 .env
#
# Rules
#   * one KEY=value per line; no spaces around "="
#   * do NOT wrap values in quotes
#   * .env is gitignored - nothing here ever ends up in the repository
#   * a real environment variable always overrides the value in this file
#     (so systemd EnvironmentFile / docker -e can take precedence)

# ---------- listener ----------

PORT=8080
# 0.0.0.0 = all interfaces, 127.0.0.1 = local only
HOST=0.0.0.0

# ---------- login ----------
# Both values must be set for authentication to be enabled.
# NEVER expose this service to the internet with these left empty.

AUTH_USER=admin
AUTH_PASS=change-this-to-a-long-random-password

# Set to 1 when the site is served over HTTPS (adds the Secure flag to the
# session cookie).
# COOKIE_SECURE=1

# ---------- RDP targets ----------
# Format:  label=host:port  , comma separated. Port defaults to 3389.
# This list IS the dial allowlist: the gateway can only reach what is listed
# here, and the browser dropdown only offers these entries.
# The label is what the page displays; the address is never shown in the UI.

RDP_TARGETS=desktop-a=192.168.1.100:3389,desktop-b=192.168.1.101:3389

# ---------- single-target mode ----------
# If RDP_TARGETS is not set, the page falls back to manual host input and this
# allowlist decides what may be dialled. Leave it tight.
# RDP_ALLOWED_DESTS=192.168.1.100:3389

# ---------- Windows launcher only (ignored on Linux) ----------
# Used by start.cmd when node is not on PATH.
# NODE_EXE=C:\Program Files\nodejs\node.exe
